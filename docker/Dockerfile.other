# syntax=docker/dockerfile:1.7
# Resolve these from the same weekly SGLang-Omni checkout before building.
ARG SGLANG_BASE_IMAGE
FROM ${SGLANG_BASE_IMAGE}

ARG APP_DIR=/opt/vllm-omni
ARG SGLANG_OMNI_COMMIT
ARG UCX_COMMIT
ARG SGLANG_BASE_IMAGE
# Match docker/Dockerfile.ci and the shared GPU runtime check.
ARG VLLM_PRECOMPILED_WHEEL_COMMIT=5df63a7203cdb9328d824a27b682e77c7b9928be
ARG VLLM_VERSION=0.32.0

ENV VLLM_OMNI_VENV=/opt/vllm-omni-benchmark
ENV SGLANG_OMNI_EXECUTABLE=/opt/sglang/bin/sgl-omni
ENV VLLM_OMNI_VERSION_OVERRIDE=0.0.0

WORKDIR ${APP_DIR}
COPY . .

RUN apt-get update && \
    apt-get install -y --no-install-recommends espeak-ng ffmpeg git jq sox libsox-fmt-all && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Inspect exactly the requested source, never resolve main again inside the build.
RUN git clone --filter=blob:none --no-checkout https://github.com/sgl-project/sglang-omni.git /tmp/sglang-omni && \
    git -C /tmp/sglang-omni checkout "${SGLANG_OMNI_COMMIT}" && \
    test "$(git -C /tmp/sglang-omni rev-parse HEAD)" = "${SGLANG_OMNI_COMMIT}"

# uv does not inherit tool.uv overrides from a Git dependency. Reuse the exact
# checkout's overrides and FlashInfer pin, including future upstream changes.
RUN /opt/sglang/bin/python3 - <<'PY'
import os
import tomllib
from pathlib import Path
from packaging.requirements import Requirement

source = Path('/tmp/sglang-omni')
project = tomllib.loads((source / 'pyproject.toml').read_text())
upstream_args = dict(
    line.removeprefix('ARG ').split('=', 1)
    for line in (source / 'docker/Dockerfile').read_text().splitlines()
    if line.startswith(('ARG SGLANG_IMAGE=', 'ARG UCX_COMMIT='))
)
assert upstream_args['SGLANG_IMAGE'] == os.environ['SGLANG_BASE_IMAGE']
assert upstream_args['UCX_COMMIT'] == os.environ['UCX_COMMIT']
Path('/tmp/sglang-overrides.txt').write_text(
    '\n'.join(project['tool']['uv']['override-dependencies']) + '\n'
)
flashinfer = [
    Requirement(value) for value in project['project']['dependencies']
    if Requirement(value).name.replace('_', '-') == 'flashinfer-python'
]
assert len(flashinfer) == 1 and str(flashinfer[0].specifier).startswith('==')
Path('/tmp/sglang-flashinfer.txt').write_text(f'flashinfer-python{flashinfer[0].specifier}\n')
PY

RUN git clone --filter=blob:none https://github.com/openucx/ucx.git /tmp/ucx && \
    git -C /tmp/ucx checkout "${UCX_COMMIT}" && \
    cd /tmp/ucx && ./autogen.sh && \
    ./contrib/configure-release-mt --enable-shared --disable-static --disable-doxygen-doc \
      --enable-optimizations --enable-cma --enable-devel-headers \
      --with-cuda=/usr/local/cuda --with-verbs --with-dm --prefix=/usr/local && \
    make -j"$(nproc)" && make install-strip && ldconfig && rm -rf /tmp/ucx

# Keep the matching FlashInfer AOT providers from the upstream base together.
RUN uv pip install --python /opt/sglang/bin/python3 --no-build-isolation --prerelease=allow \
      --overrides /tmp/sglang-overrides.txt \
      "sglang-omni[minicpm-o] @ git+https://github.com/sgl-project/sglang-omni.git@${SGLANG_OMNI_COMMIT}" \
      "pytest>=8" && \
    uv pip install --python /opt/sglang/bin/python3 --no-deps "qwen-tts==0.1.1" && \
    uv pip install --python /opt/sglang/bin/python3 --no-deps --reinstall -r /tmp/sglang-flashinfer.txt && \
    rm -rf /tmp/sglang-omni /tmp/sglang-overrides.txt /tmp/sglang-flashinfer.txt && \
    uv venv --python /opt/sglang/bin/python3 "${VLLM_OMNI_VENV}" && \
    VLLM_OMNI_TARGET_DEVICE=cuda uv pip install --python "${VLLM_OMNI_VENV}/bin/python" \
      "vllm @ https://wheels.vllm.ai/${VLLM_PRECOMPILED_WHEEL_COMMIT}/vllm-${VLLM_VERSION}-cp38-abi3-manylinux_2_28_$(uname -m).whl" \
      -e ".[dev]"

RUN "${VLLM_OMNI_VENV}/bin/python" -c "from vllm._version import __commit_id__; commit = (__commit_id__ or '').removeprefix('g'); assert len(commit) >= 8 and '${VLLM_PRECOMPILED_WHEEL_COMMIT}'.startswith(commit), __commit_id__"

# Every comparison job consumes these patches once, from the shared image.
# Upstream fixes are accepted only when the same CPU semantic tests pass.
RUN /opt/sglang/bin/python3 docker/patches/apply_comparison_patches.py && \
    CUDA_VISIBLE_DEVICES="" HF_HUB_OFFLINE=1 /opt/sglang/bin/python3 -c \
      "from sglang_omni.models.minicpm_o.components.token2wav.speech_tokenizer_weights import load_tokenizer_weights"

# pytest and the common benchmark client use vLLM; only the server uses SGLang.
ENV PATH=${VLLM_OMNI_VENV}/bin:${PATH}
ENTRYPOINT []
