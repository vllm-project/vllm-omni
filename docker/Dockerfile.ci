# Install the v0.33.0 release candidate from its frozen commit index.
# Bootstrap from the published v0.32.0 image; uv resolves the selected
# wheel's dependencies, including the v0.33.0 Torch runtime, below.
ARG VLLM_PRECOMPILED_WHEEL_COMMIT=4ba787ec9959e566d3b587a796dff07673324da5
ARG VLLM_VERSION=0.33.0rc3.dev3+g4ba787ec9
ARG VLLM_BASE_IMAGE=vllm/vllm-openai
ARG VLLM_BASE_TAG=v0.32.0@sha256:befccf0e7e4089aa23926bb6f887a85c0d46c2a99e6de5c5ffdf5cb7957c5b34

# We use registry-based layer caching for the dependencies,
# where the tag is determined based on the hash of the contents
# of files like pyproject.toml, etc. The deps stage should have
# everything except the actual project dir, since that should not
# change much across branches.
FROM ${VLLM_BASE_IMAGE}:${VLLM_BASE_TAG} AS deps
ARG VLLM_PRECOMPILED_WHEEL_COMMIT
ARG VLLM_VERSION
# Keep APP_DIR outside /workspace so k8s Buildkite workspace mounts cannot
# shadow the editable install target (#5364). Docker WORKDIR creates /opt if
# needed.
ARG APP_DIR=/opt/vllm-omni
WORKDIR ${APP_DIR}

RUN ln -sf /usr/bin/python3 /usr/bin/python

# Placeholder package tree so editable install can register APP_DIR.
# The final stage COPY --link fills this directory with the real sources;
# the editable .pth / egg-link keeps resolving imports there — no PYTHONPATH.
RUN mkdir -p vllm_omni && touch vllm_omni/__init__.py

# Install system dependencies
RUN apt-get update && \
    apt-get install -y espeak-ng git jq && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency related things first and install deps/
# We set the version str to 0.0.0 since it doesn't matter
# for CI
COPY pyproject.toml setup.py ./
COPY requirements/ requirements/
COPY tools/build_gradio_pillow13.py tools/build_gradio_pillow13.py
COPY tools/prepare_ci_telemetry.py tools/prepare_ci_telemetry.py
COPY tools/gradio_pillow13/ tools/gradio_pillow13/
# Scope the override to Omni; dependency source builds need their own versions.
ENV VLLM_OMNI_VERSION_OVERRIDE=0.0.0
# Editable install: deps + project metadata are cached in this layer, while
# the package itself is linked to APP_DIR (populated later by COPY --link).
# Do NOT use a non-editable install here — that copies an empty stub into
# site-packages and breaks ``import vllm_omni.entrypoints``.
RUN python3 tools/build_gradio_pillow13.py --output-dir /tmp/gradio-pillow13
# Keep LMCache's installed native version and real telemetry constraints in the
# same solve. The pinned bootstrap can contain a new, unused common exporter
# alongside the old 1.40 family. Remove it only after conservative metadata and
# file-ownership checks prove it is an orphan; retained exporters stay requested.
RUN python3 tools/prepare_ci_telemetry.py --roots /tmp/vllm-otel-roots.txt \
    --orphans /tmp/vllm-otel-orphans.txt && \
    if [ -s /tmp/vllm-otel-orphans.txt ]; then \
        uv pip uninstall --system opentelemetry-exporter-otlp-common; \
    fi
RUN VLLM_WHEEL_VERSION=$(printf '%s' "${VLLM_VERSION}" | sed 's/+/%2B/g') && \
    uv pip install --system -r /tmp/vllm-otel-roots.txt \
    /tmp/gradio-pillow13/gradio-6.31.0+omni.pillow13-py3-none-any.whl \
    "vllm @ https://wheels.vllm.ai/${VLLM_PRECOMPILED_WHEEL_COMMIT}/vllm-${VLLM_WHEEL_VERSION}-cp38-abi3-manylinux_2_28_$(uname -m).whl" \
    -e ".[dev]"
RUN uv pip check --system && rm -rf /tmp/gradio-pillow13 /tmp/vllm-otel-roots.txt /tmp/vllm-otel-orphans.txt
# Fail the image build if dependency resolution replaced the selected vLLM.
# The CPU builder has no NVIDIA driver; CUDA imports are checked at the start
# of each GPU test job by .buildkite/cuda/scripts/check_vllm_runtime.py.
RUN python3 -c "from vllm._version import __commit_id__; commit = (__commit_id__ or '').removeprefix('g'); assert len(commit) >= 8 and '${VLLM_PRECOMPILED_WHEEL_COMMIT}'.startswith(commit), __commit_id__"

# The final stage just copies the working dir on top of the
# dependencies image. This uses --link so that we can skip
# the image pull in Buildkite when we have a cache hit.
#
# IMPORTANT: Do not make any modifications that depend on the
# file system after the --link copy, otherwise we'd need to pull
# the heavy base image to build it. Editable install above already
# registered APP_DIR, so we must not re-pip-install after COPY.
FROM deps
ARG APP_DIR=/opt/vllm-omni
WORKDIR ${APP_DIR}

COPY --link . .

ENTRYPOINT []
