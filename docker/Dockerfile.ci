# Install the final v0.33.0 package from its frozen commit index.
# Use the matching published v0.33.0 image and verify the selected runtime
# from its exact frozen wheel below.
ARG VLLM_PRECOMPILED_WHEEL_COMMIT=4ba787ec9959e566d3b587a796dff07673324da5
ARG VLLM_VERSION=0.33.0
ARG VLLM_BASE_IMAGE=vllm/vllm-openai
# Update the digest together with VLLM_VERSION; the digest selects the image bytes.
ARG VLLM_BASE_TAG=v${VLLM_VERSION}@sha256:d825baf9ce4b1b6bfc5ecc7b79880c7e6748c65a72d697ce3d47607aafa84c6e

# We use registry-based layer caching for the dependencies,
# where the tag is determined based on the hash of the contents
# of files like pyproject.toml, etc. The deps stage should have
# everything except the actual project dir, since that should not
# change much across branches.
FROM ${VLLM_BASE_IMAGE}:${VLLM_BASE_TAG} AS deps
ARG VLLM_BASE_IMAGE
ARG VLLM_BASE_TAG
# The base overrides Torch's NCCL dependency for its optional EFA build.
# Resolve the official wheel's declared dependencies for the Omni runtime.
ENV UV_OVERRIDE=""
ARG VLLM_PRECOMPILED_WHEEL_COMMIT
ARG VLLM_VERSION
# Keep APP_DIR outside /workspace so k8s Buildkite workspace mounts cannot
# shadow the editable install target (#5364). Docker WORKDIR creates /opt if
# needed.
ARG APP_DIR=/opt/vllm-omni
WORKDIR ${APP_DIR}

RUN ln -sf /usr/bin/python3 /usr/bin/python

# Placeholder package tree so editable install can register APP_DIR.
# The final stage COPY --link fills this directory with the real sources;
# the editable .pth / egg-link keeps resolving imports there — no PYTHONPATH.
RUN mkdir -p vllm_omni && touch vllm_omni/__init__.py

# Install system dependencies
RUN apt-get update && \
    apt-get install -y espeak-ng git jq && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency related things first and install deps/
# We set the version str to 0.0.0 since it doesn't matter
# for CI
COPY pyproject.toml setup.py ./
COPY requirements/ requirements/
COPY tools/build_gradio_pillow13.py tools/build_gradio_pillow13.py
COPY tools/prepare_ci_telemetry.py tools/prepare_ci_telemetry.py
COPY tools/gradio_pillow13/ tools/gradio_pillow13/
# Scope the override to Omni; dependency source builds need their own versions.
ENV VLLM_OMNI_VERSION_OVERRIDE=0.0.0
# Editable install: deps + project metadata are cached in this layer, while
# the package itself is linked to APP_DIR (populated later by COPY --link).
# Do NOT use a non-editable install here — that copies an empty stub into
# site-packages and breaks ``import vllm_omni.entrypoints``.
RUN python3 tools/build_gradio_pillow13.py --output-dir /tmp/gradio-pillow13
# This exact base contains an unused exporter requiring a newer SDK than
# LMCache supports. Validate its known metadata before removing that orphan.
RUN python3 tools/prepare_ci_telemetry.py "${VLLM_BASE_IMAGE}:${VLLM_BASE_TAG}" && \
    uv pip uninstall --system opentelemetry-exporter-otlp-common
RUN uv pip install --system -r requirements/cuda-bootstrap.txt \
    "nvidia-nccl-cu13==2.30.7" \
    /tmp/gradio-pillow13/gradio-6.31.0+omni.pillow13-py3-none-any.whl \
    "vllm @ https://wheels.vllm.ai/${VLLM_PRECOMPILED_WHEEL_COMMIT}/vllm-${VLLM_VERSION}-cp38-abi3-manylinux_2_28_$(uname -m).whl" \
    -e ".[dev]"
# The final base's LMCache wheel was compiled against Torch 2.13. Its CUDA
# extension references a c10 symbol removed in Torch 2.14. Follow LMCache's
# source workflow so the unchanged release is compiled against this runtime.
RUN uv pip install --system -r requirements/cuda-bootstrap.txt \
    ninja "packaging>=24.2" "setuptools>=77.0.3,<81.0.0" \
    "setuptools_scm>=8" "grpcio==1.78.0" "grpcio-tools==1.78.0" wheel
# CUDA builder images can lack the math-library headers supplied by the
# installed NVIDIA packages. Keep all published LMCache CUDA architectures.
# Disable the installer cache so an older Torch-specific source wheel cannot
# satisfy this rebuild merely because its Python package version is unchanged.
RUN PYTHON_SITE=$(python3 -c 'import sysconfig; print(sysconfig.get_path("purelib"))') && \
    test -f "${PYTHON_SITE}/nvidia/cu13/include/cusparse.h" && \
    test -f "${PYTHON_SITE}/nvidia/cusparselt/include/cusparseLt.h" && \
    CUDA_VISIBLE_DEVICES="" CUDA_HOME=/usr/local/cuda BUILD_WITH_CUDA=1 MAX_JOBS=3 NVCC_THREADS=1 \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0;10.0;11.0;12.0" \
    CPATH="${PYTHON_SITE}/nvidia/cu13/include:${PYTHON_SITE}/nvidia/cusparselt/include${CPATH:+:${CPATH}}" \
    uv pip install --system --no-cache --no-binary lmcache \
    --no-build-isolation-package lmcache --reinstall-package lmcache \
    -r requirements/cuda-bootstrap.txt "lmcache==0.5.6"
RUN uv pip check --system && rm -rf /tmp/gradio-pillow13
# cuDNN 9.24 causes the original Qwen-Image 2.1 pixel gate to fail under
# Torch 2.14. Keep Torch's declared Python dependencies and load the verified
# NVIDIA 9.25.1 wheel in a private target outside Python's import path.
RUN uv pip install --target /opt/vllm-omni-cudnn --no-deps --only-binary=:all: \
    --require-hashes -r requirements/cudnn-runtime.txt
ENV LD_PRELOAD="/opt/vllm-omni-cudnn/nvidia/cudnn/lib/libcudnn.so.9 ${LD_PRELOAD:-}"
ENV LD_LIBRARY_PATH="/opt/vllm-omni-cudnn/nvidia/cudnn/lib:${LD_LIBRARY_PATH:-/usr/local/nvidia/lib:/usr/local/nvidia/lib64}"

# PAN 2 guardrails stay on for the image-to-video doc test. This file is not
# part of the published extras: a git URL in pyproject optional-dependencies
# would be Requires-Dist, which PyPI rejects. --no-deps keeps the already
# installed torch, torchvision, and transformers. ftfy and regex are the
# import-time deps of clip.simple_tokenizer that the image may not have.
RUN uv pip install --system --no-deps -r requirements/ci-pan2-guardrail.txt \
    && uv pip install --system "ftfy>=6.1.1" "regex>=2022.1.18"

# Fail the image build if dependency resolution replaced the selected vLLM.
# The CPU builder has no NVIDIA driver; CUDA imports are checked at the start
# of each GPU test job by .buildkite/cuda/scripts/check_vllm_runtime.py.
RUN python3 -c "from vllm._version import __commit_id__, __version__; commit = (__commit_id__ or '').removeprefix('g'); assert len(commit) >= 8 and '${VLLM_PRECOMPILED_WHEEL_COMMIT}'.startswith(commit), __commit_id__; assert __version__ == '${VLLM_VERSION}', __version__"

# Exercise ordinary tools and Torch CPU operations with the preload enabled.
# Record driver/device visibility so a CPU-builder result has an explicit scope.
RUN uv pip check --system && python3 - <<'PY'
import glob
import json
import os
from pathlib import Path

import importlib.metadata as metadata

import torch
from clip.model import VisionTransformer
import pan2_guardrail

maps = Path("/proc/self/maps").read_text()
assert any(os.path.realpath(path) in maps for path in os.environ["LD_PRELOAD"].split() if "libcudnn.so.9" in path)
assert torch.arange(4, device="cpu").sum().item() == 6
cuda_available = torch.cuda.is_available()
assert not torch.cuda.is_initialized()
assert VisionTransformer is not None
assert pan2_guardrail.PAN2SafetyChecker is not None
print(json.dumps({
    "cpu_preload_smoke": "passed",
    "cudnn": torch.backends.cudnn.version(),
    "torch": metadata.version("torch"),
    "torchvision": metadata.version("torchvision"),
    "transformers": metadata.version("transformers"),
    "pan2-guardrail": metadata.version("pan2-guardrail"),
    "cuda_available": cuda_available,
    "cuda_initialized": torch.cuda.is_initialized(),
    "gpu_device_nodes": sorted(glob.glob("/dev/nvidia*")),
    "driver_module_visible": Path("/sys/module/nvidia").exists(),
    "driver_proc_visible": Path("/proc/driver/nvidia/version").exists(),
}))
PY

# The final stage just copies the working dir on top of the
# dependencies image. This uses --link so that we can skip
# the image pull in Buildkite when we have a cache hit.
#
# IMPORTANT: Do not make any modifications that depend on the
# file system after the --link copy, otherwise we'd need to pull
# the heavy base image to build it. Editable install above already
# registered APP_DIR, so we must not re-pip-install after COPY.
FROM deps
ARG APP_DIR=/opt/vllm-omni
WORKDIR ${APP_DIR}

COPY --link . .

ENTRYPOINT []
