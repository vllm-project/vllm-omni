ARG BASE_IMAGE=vllm/vllm-openai:v0.29.0
FROM ${BASE_IMAGE}

ARG COMMON_WORKDIR=/app
ARG INSTALL_FA3_FWD=1

WORKDIR ${COMMON_WORKDIR}

# Step 1: Setup - Install system dependencies
RUN apt-get update && \
    apt-get install -y git jq && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p ${COMMON_WORKDIR}/vllm-omni

# Step 2: Copy vllm-omni code and install
COPY . ${COMMON_WORKDIR}/vllm-omni
RUN cd ${COMMON_WORKDIR}/vllm-omni && \
    if [ "${INSTALL_FA3_FWD}" = "1" ]; then \
        uv pip install --python "$(python3 -c 'import sys; print(sys.executable)')" --no-cache-dir ".[fa3]"; \
    else \
        uv pip install --python "$(python3 -c 'import sys; print(sys.executable)')" --no-cache-dir "."; \
    fi

RUN ln -sf /usr/bin/python3 /usr/bin/python

ENTRYPOINT []
