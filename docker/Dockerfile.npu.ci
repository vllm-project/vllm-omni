# vLLM-Ascend v0.33.0 runtime matching the vLLM v0.33.0 alignment. CI injects
# the per-device tag suffix through VLLM_ASCEND_DEVICE_SUFFIX (-a3/-a5/-310p);
# the unsuffixed tag is the generic image used for A2.
ARG VLLM_ASCEND_IMAGE=quay.io/atlas-ci/vllm-ascend
ARG VLLM_ASCEND_VERSION=v0.33.0
ARG VLLM_ASCEND_DEVICE_SUFFIX=
FROM ${VLLM_ASCEND_IMAGE}:${VLLM_ASCEND_VERSION}${VLLM_ASCEND_DEVICE_SUFFIX}

ARG VLLM_ASCEND_DEVICE_SUFFIX
# Includes the CANN 9.2.1 Runtime symbol-loading fix (cann/shmem !966).
ARG CANN_SHMEM_COMMIT=f6df6ba3fa962484b2629e7e8ad7e6e15e3190b6
ARG APP_DIR=/vllm-workspace/vllm-omni
WORKDIR ${APP_DIR}

RUN sed -i "s@^\(deb.*\)https\?://[a-z0-9.-]*\.ubuntu\.com@\1http://cache-service.nginx-pypi-cache.svc.cluster.local:8081@g" /etc/apt/sources.list

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        cmake \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libjemalloc2 \
        libsm6 \
        libxext6 \
        libxrender1 \
        libxcb1 \
        make \
        espeak-ng && \
    rm -rf /var/cache/apt/* && \
    rm -rf /var/lib/apt/lists/*

# Avoid glibc heap corruption at Python shutdown with the NPU runtime.
ENV LD_PRELOAD=libjemalloc.so.2

# The A2 Ulysses lane needs the native runtime, not its Python extension.
# Keep bootstrap plugins beside libshmem.so and make the installation visible
# to both TorchNPU's allocator and the Python transport in fresh processes.
RUN if [ -z "${VLLM_ASCEND_DEVICE_SUFFIX}" ]; then \
      source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
      git clone --no-checkout --filter=blob:none https://gitcode.com/cann/shmem.git /tmp/cann-shmem && \
      git -C /tmp/cann-shmem checkout --detach "${CANN_SHMEM_COMMIT}" && \
      cd /tmp/cann-shmem && \
      CMAKE_BUILD_PARALLEL_LEVEL=8 bash scripts/build.sh && \
      mkdir -p /opt/cann-shmem && \
      cp -a install/shmem/lib /opt/cann-shmem/lib && \
      echo /opt/cann-shmem/lib > /etc/ld.so.conf.d/cann-shmem.conf && \
      ldconfig && \
      python3 -c 'import ctypes; ctypes.CDLL("libshmem.so").aclshmemx_barrier_all_on_stream' && \
      cd / && rm -rf /tmp/cann-shmem; \
    fi

RUN python3 -m pip install -U pip && \
    python3 -m pip install -v \
      "mindiesd==3.2.0" \
      "pytest>=7.0.0" \
      "pytest-asyncio>=0.21.0" \
      "pytest-cov>=4.0.0" \
      "pytest-mock>=3.10.0" \
      "pytest-xdist==3.8.0" \
      "openpyxl>=3.0.0" \
      "psutil>=7.2.0" \
      "soundfile>=0.13.1" \
      "pyttsx3>=2.99" \
      "opencc==1.4.1" \
      "opencv-python>=4.12.0.88" \
      "imageio[ffmpeg]>=0.6.0" \
      "jiwer>=3.0.0" \
      "zhon>=2.0.0" \
      "zhconv>=1.4.2" \
      "funasr>=1.0.0" \
      "hyperpyyaml>=1.2.0" \
      "onnx>=1.16.0" \
      "librosa>=0.10.0" \
      "datasets>=3.0.0" \
      "torchmetrics==1.9.0" \
      --index-url http://cache-service.nginx-pypi-cache.svc.cluster.local/pypi/simple \
      --trusted-host cache-service.nginx-pypi-cache.svc.cluster.local \
      --default-timeout=60

COPY . .

RUN source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/Ascend/ascend-toolkit/latest/`uname -i`-linux/devlib && \
    python3 -m pip install -v -e /vllm-workspace/vllm-omni/ --no-build-isolation \
      --index-url http://cache-service.nginx-pypi-cache.svc.cluster.local/pypi/simple \
      --trusted-host cache-service.nginx-pypi-cache.svc.cluster.local \
      --default-timeout=60

# MiniCPM-o 4.5 Stage-2 vocoder assets: s3tokenizer plus flashcosyvoice, which
# is shipped by step-audio2. --no-deps keeps pip from replacing the Ascend torch
# build and from shadowing onnxruntime-cann with the vanilla onnxruntime wheel;
# the deps these two actually need are installed above.
RUN python3 -m pip install -v --no-deps \
      "s3tokenizer>=0.3.0" \
      "step-audio2>=1.0.0" \
      --index-url http://cache-service.nginx-pypi-cache.svc.cluster.local/pypi/simple \
      --trusted-host cache-service.nginx-pypi-cache.svc.cluster.local \
      --default-timeout=60

ENV VLLM_TARGET_DEVICE=npu
ENV VLLM_WORKER_MULTIPROC_METHOD=spawn

ENTRYPOINT []
