#!/bin/bash
#PBS -N longcat_next_audio_smoke
#PBS -l select=1:ncpus=64:ngpus=4:mem=440gb
#PBS -l walltime=00:30:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_audio_smoke.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_audio_smoke.err

# LongCat-Next thinker + audio decoder smoke test, colocated on 4x GPU (no
# node on this cluster has >4 GPUs). Thinker stays TP=4 (proven); the audio
# decoder is colocated on GPU 3 at gpu_memory_utilization=0.1, sized off a
# standalone measurement (pbs/longcat_next_audio_decoder_standalone.pbs)
# showing the module only needs ~3.1 GB. CPU offload and TP=2 were both tried
# and ruled out first — see longcat_next_4gpu_audio.yaml's comments for why.
# The audio decoder module itself is now confirmed working (standalone decode
# of synthetic per-level-valid codes succeeded). Still untested: the 2-stage
# pipeline wiring (longcat_next_thinker_audio) end-to-end, and real thinker ->
# audio-decoder handoff via thinker2audio_decoder_token_only.

set -u

# ---- env ------------------------------------------------------------------
export CUDA_VISIBLE_DEVICES=0,1,2,3
export CUDA_HOME=/app/apps/cuda/12.8.1
export HF_HOME=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads
export UV_CACHE_DIR=/scratch/users/ntu/karthik0/.uv_cache
export NCCL_DEBUG=INFO
export VLLM_LOG_STATS_INTERVAL=10
export VLLM_USE_FLASHINFER_SAMPLER=0

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VENV="$OMNI_DIR/.venv"
export MODEL_PATH=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads/hub/models--meituan-longcat--LongCat-Next/snapshots/0cf0631862402ff36366e513e4023d22e7e5c84c
DEPLOY_CONFIG="$OMNI_DIR/vllm_omni/deploy/longcat_next_4gpu_audio.yaml"
export RESULT_DIR="$OMNI_DIR/pbs/logs"
SERVER_LOG="$RESULT_DIR/longcat_next_audio_server.log"
export PORT=8092

mkdir -p "$RESULT_DIR"
source "$VENV/bin/activate"
cd "$OMNI_DIR"

echo "[$(date)] node=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
nvidia-smi -L

# ---- unit tests first -------------------------------------------------------
echo "[$(date)] Running longcat_next stage-processor tests..."
python -m pytest tests/model_executor/stage_input_processors/test_longcat_next.py -q \
  || { echo "[$(date)] Unit tests FAILED — aborting before GPU run"; exit 1; }

# ---- kill any leftover vllm procs ------------------------------------------
pkill -u "$(id -un)" -f "vllm.entrypoints" 2>/dev/null || true
sleep 5

# ---- start vllm-omni server (thinker TP=4 + audio decoder) -----------------
echo "[$(date)] Starting vLLM-Omni server for LongCat-Next (thinker+audio)..."
python -m vllm.entrypoints.cli.main serve "$MODEL_PATH" --omni \
  --deploy-config "$DEPLOY_CONFIG" \
  --host 0.0.0.0 \
  --port "$PORT" \
  --trust-remote-code \
  > "$SERVER_LOG" 2>&1 &
SERVER_PID=$!

# ---- wait for readiness -----------------------------------------------------
echo "[$(date)] Waiting for server (pid=$SERVER_PID)..."
for i in $(seq 1 120); do
  if curl -sf "http://127.0.0.1:$PORT/health" > /dev/null 2>&1; then
    echo "[$(date)] Server healthy after ~$((i * 15))s"
    break
  fi
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "[$(date)] Server process died; tail of log:"
    tail -80 "$SERVER_LOG"
    exit 1
  fi
  sleep 15
done

if ! curl -sf "http://127.0.0.1:$PORT/health" > /dev/null 2>&1; then
  echo "[$(date)] Server never became healthy; tail of log:"
  tail -80 "$SERVER_LOG"
  kill "$SERVER_PID" 2>/dev/null
  exit 1
fi

# ---- smoke request: speech synthesis (voice-cloned TTS) --------------------
# Per the checkpoint's README "Audio - Speech Synthesis Example": a system
# message references a reference-voice clip, the user message ends with
# <longcat_audiogen_start> to force the thinker to emit audiogen codes, and
# request.modalities=["text","audio"] tells the serving layer to package the
# stage-2 (audio decoder) output back to the client. Sampling params per the
# README's "Audio - Audio-to-Audio/Speech Synthesis" recommendation.
echo "[$(date)] Speech-synthesis (voice-cloning) smoke request..."
python - <<'EOF'
import base64
import json
import os
import urllib.request

model = os.environ["MODEL_PATH"]
port = os.environ["PORT"]
result_dir = os.environ["RESULT_DIR"]

ref_voice_path = os.path.join(model, "assets", "vc_zh3.wav")
with open(ref_voice_path, "rb") as f:
    ref_b64 = base64.b64encode(f.read()).decode()

payload = {
    "model": model,
    "messages": [
        {
            "role": "system",
            "content": (
                "Replicate the voice in the audio clip to formulate an answer:"
                "<longcat_audio_start>"
            ),
        },
        {
            "role": "user",
            "content": (
                "Please say: Hello, this is a test of LongCat-Next speech synthesis."
                "<longcat_audiogen_start>"
            ),
        },
    ],
    # The system message's reference audio is attached via input_audio content,
    # matching the same pattern used for audio-understanding requests. If this
    # doesn't work, the raw log/response below will show why.
    "modalities": ["text", "audio"],
    "max_tokens": 2048,
    "temperature": 0.2,
    "top_p": 0.85,
    "extra_body": {"top_k": 20, "repetition_penalty": 1.1},
}

# Attach the reference audio as multimodal content on the system message
# (mirrors the checkpoint's <longcat_audio_start>...<longcat_audio_end> path
# but via vLLM's structured input_audio content block instead of a raw path).
payload["messages"][0]["content"] = [
    {"type": "text", "text": "Replicate the voice in the audio clip to formulate an answer:"},
    {"type": "input_audio", "input_audio": {"data": ref_b64, "format": "wav"}},
]

req = urllib.request.Request(
    f"http://127.0.0.1:{port}/v1/chat/completions",
    data=json.dumps(payload).encode(),
    headers={"Content-Type": "application/json"},
)
try:
    with urllib.request.urlopen(req, timeout=900) as resp:
        body = resp.read().decode()
        status = resp.status
except urllib.error.HTTPError as e:
    body = e.read().decode()
    status = e.code

print(f"HTTP {status}")
print(body[:4000])
with open(os.path.join(result_dir, "smoke_audio_gen.json"), "w") as f:
    f.write(body)

# Dump whether an audio field is actually present, without assuming its exact
# shape (first time this code path has ever run).
try:
    parsed = json.loads(body)
    msg = parsed.get("choices", [{}])[0].get("message", {})
    print("message keys:", list(msg.keys()))
    if "audio" in msg and msg["audio"]:
        print("audio field present, keys:", list(msg["audio"].keys()) if isinstance(msg["audio"], dict) else type(msg["audio"]))
except Exception as e:
    print(f"Could not parse response as expected chat-completion JSON: {e}")
EOF

echo "[$(date)] Smoke test done; shutting down server."
kill "$SERVER_PID" 2>/dev/null
wait "$SERVER_PID" 2>/dev/null
echo "[$(date)] Done. Results in $RESULT_DIR (smoke_audio_gen.json, longcat_next_audio_server.log)."
