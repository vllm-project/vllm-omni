#!/bin/bash
#PBS -N longcat_image_decoder_standalone
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=00:10:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_image_decoder_standalone.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_image_decoder_standalone.err

# Standalone LongcatNextImageDecoder smoke test: no vLLM engine, no
# orchestrator, no thinker. Mirrors longcat_next_audio_decoder_standalone.pbs
# -- constructs the module, loads its weights, and decodes synthetic visual
# codes on a single GPU to measure real VRAM footprint before attempting a
# 3-stage (thinker + image + audio) colocated pipeline.

set -u
export CUDA_VISIBLE_DEVICES=0
export CUDA_HOME=/app/apps/cuda/12.8.1
export HF_HOME=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads
export UV_CACHE_DIR=/scratch/users/ntu/karthik0/.uv_cache

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VENV="$OMNI_DIR/.venv"
MODEL_PATH=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads/hub/models--meituan-longcat--LongCat-Next/snapshots/0cf0631862402ff36366e513e4023d22e7e5c84c

source "$VENV/bin/activate"
cd "$OMNI_DIR"

echo "[$(date)] node=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
python pbs/scripts/longcat_next_image_decoder_standalone.py "$MODEL_PATH"
echo "[$(date)] Done."
