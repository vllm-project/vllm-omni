#!/bin/bash
#PBS -N longcat_next_mn_audio
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=00:15:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_mn_audio.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_mn_audio.err

# Node B of the 2-node LongCat-Next thinker+audio e2e test. See
# longcat_next_multinode_thinker.pbs for the full design rationale
# (this cluster has no >4-GPU nodes, so the pipeline is split across two
# single-node jobs joined by a shared scratch file instead of real
# cross-node tensor/pipeline parallelism).
#
# Only needs 1 GPU: the standalone measurement in
# pbs/longcat_next_audio_decoder_standalone.pbs showed the audio decoder
# (VQ bridger + flow-matching model + Cosy24k vocoder, no MoE weights) loads
# in ~3.1 GB total (peak 2.49 GB). It is not autoregressive, so it runs as
# a plain Python call -- no vLLM engine/server needed on this node either.
#
# PBS submission order (from the login/head node):
#   jobA=$(qsub pbs/longcat_next_multinode_thinker.pbs)
#   qsub -W depend=afterok:$jobA pbs/longcat_next_multinode_audio_decoder.pbs
# `afterok` ensures this job only starts once node A's handoff file exists
# and the thinker exited 0.

set -u

export CUDA_HOME=/app/apps/cuda/12.8.1
export HF_HOME=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads
export UV_CACHE_DIR=/scratch/users/ntu/karthik0/.uv_cache
export PYTHONFAULTHANDLER=1
export PYTHONUNBUFFERED=1
export TORCH_SHOW_CPP_STACKTRACES=1
export CUDA_LAUNCH_BLOCKING=1

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VENV="$OMNI_DIR/.venv"
MODEL_PATH=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads/hub/models--meituan-longcat--LongCat-Next/snapshots/0cf0631862402ff36366e513e4023d22e7e5c84c
RESULT_DIR="$OMNI_DIR/pbs/logs"
HANDOFF_JSON="$RESULT_DIR/longcat_next_mn_handoff.json"
OUT_WAV="$RESULT_DIR/longcat_next_mn_output.wav"
RUN_TS="$(date +%Y%m%d_%H%M%S)"
RUN_LOG="$RESULT_DIR/longcat_next_mn_audio_${RUN_TS}.log"
STATUS_FILE="$RESULT_DIR/.mn_audio_status_$$"

mkdir -p "$RESULT_DIR"
source "$VENV/bin/activate"
cd "$OMNI_DIR"

{
echo "[$(date)] ===== LongCat-Next multinode AUDIO DECODER ====="
echo "[$(date)] job=${PBS_JOBID:-<none>} node=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
echo "[$(date)] run_log=$RUN_LOG"
nvidia-smi -L

if [ ! -f "$HANDOFF_JSON" ]; then
  echo "[$(date)] FAIL: handoff file $HANDOFF_JSON not found -- did node A's job finish successfully first?"
  echo 1 > "$STATUS_FILE"
else
echo "[$(date)] handoff size: $(wc -c < "$HANDOFF_JSON") bytes; head: $(head -c 400 "$HANDOFF_JSON")"

echo "[$(date)] Decoding audio from thinker handoff -> $OUT_WAV ..."
stdbuf -oL -eL python -X faulthandler pbs/scripts/longcat_next_multinode_audio_decoder.py \
  "$MODEL_PATH" "$HANDOFF_JSON" "$OUT_WAV"
status=$?

echo "[$(date)] audio decoder python exited status=$status"
if [ -f "$OUT_WAV" ]; then
  echo "[$(date)] output wav size: $(wc -c < "$OUT_WAV") bytes"
fi

if [ $status -ne 0 ]; then
  echo "[$(date)] Audio decoder stage FAILED (exit=$status)"
else
  echo "[$(date)] Done. Output audio: $OUT_WAV"
fi
echo "$status" > "$STATUS_FILE"
fi
} 2>&1 | tee "$RUN_LOG"

{
echo "[$(date)] ================ MULTINODE AUDIO DECODER SUMMARY ================"
echo "--- memory ---"
grep -a -E "before load|after weight load" "$RUN_LOG"
echo "--- decode result ---"
grep -a -E "\[audio_decoder\] (OK|wrote)" "$RUN_LOG"
echo "--- verdict ---"
grep -a "VERDICT" "$RUN_LOG"
echo "[$(date)] =================================================================="
} 2>&1 | tee -a "$RUN_LOG"

status="$(cat "$STATUS_FILE" 2>/dev/null || echo 1)"
rm -f "$STATUS_FILE"
exit "$status"
