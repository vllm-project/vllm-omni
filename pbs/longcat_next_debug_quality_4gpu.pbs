#!/bin/bash
#PBS -N longcat_next_debug_quality_4gpu
#PBS -l select=1:ncpus=64:ngpus=4:mem=440gb
#PBS -l walltime=00:20:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_debug_quality_4gpu.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_debug_quality_4gpu.err

# LongCat-Next text-quality re-check on 4x A100-40GB (TP=4, fp8 thinker-only,
# longcat_next_4gpu.yaml -- the only deploy config actually measured to fit
# this cluster's 39.49 GiB-usable cards, see that file's header comment).
#
# Purpose: verify the MLA q/kv LoRA scale-fold fix (removal of the redundant
# _apply_mla_scale_fold in modeling_longcat_next.py -- the scaling is already
# applied, correctly guarded, by the inherited FlashModel.load_weights) by
# running longcat_next_debug_quality.py's text-only prompt and inspecting
# whether the "coherent but generic" Chinese self-introduction output is now
# specific rather than generic/repetitive.
#
# NOTE on walltime: longcat_next_smoke.pbs allows up to 30 min just for
# server-readiness polling on this checkpoint ("74B over 15 shards takes a
# while"), and this script loads the same TP=4 fp8 thinker in-process
# (Omni(...) blocks on load, no server/polling loop). 20 min may be tight for
# a cold load + one generate() call -- if this times out before
# quality_diagnostics.json is written, re-submit with a longer walltime
# rather than assuming the fix failed.

set -u

export CUDA_VISIBLE_DEVICES=0,1,2,3
export CUDA_HOME=/app/apps/cuda/12.8.1
export HF_HOME=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads
export UV_CACHE_DIR=/scratch/users/ntu/karthik0/.uv_cache
export NCCL_DEBUG=WARN
export VLLM_LOG_STATS_INTERVAL=10
export VLLM_USE_FLASHINFER_SAMPLER=0
export VLLM_LOGGING_LEVEL=INFO
export PYTHONFAULTHANDLER=1
export PYTHONUNBUFFERED=1
export TORCH_SHOW_CPP_STACKTRACES=1

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VENV="$OMNI_DIR/.venv"
MODEL_PATH=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads/hub/models--meituan-longcat--LongCat-Next/snapshots/0cf0631862402ff36366e513e4023d22e7e5c84c
DEPLOY_CONFIG="$OMNI_DIR/vllm_omni/deploy/longcat_next_4gpu.yaml"
RESULT_DIR="$OMNI_DIR/pbs/logs"
RUN_TS="$(date +%Y%m%d_%H%M%S)"
OUT_DIR="$RESULT_DIR/longcat_next_debug_quality_4gpu_${RUN_TS}"
RUN_LOG="${OUT_DIR}.log"

mkdir -p "$RESULT_DIR" "$OUT_DIR"
source "$VENV/bin/activate"
cd "$OMNI_DIR"

{
echo "[$(date)] ===== LongCat-Next text-quality re-check (4x40GB, fp8 TP=4) ====="
echo "[$(date)] job=${PBS_JOBID:-<none>} node=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
echo "[$(date)] out_dir=$OUT_DIR"
nvidia-smi -L
echo "[$(date)] --- code version ---"
git -C "$OMNI_DIR" rev-parse HEAD 2>/dev/null && git -C "$OMNI_DIR" status --short 2>/dev/null | head -30
echo "[$(date)] --- deploy config ---"
cat "$DEPLOY_CONFIG"

pkill -u "$(id -un)" -f "vllm.entrypoints" 2>/dev/null || true
sleep 5

echo "[$(date)] Running text-only quality diagnostic ..."
stdbuf -oL -eL python -X faulthandler pbs/scripts/longcat_next_debug_quality.py \
  "$MODEL_PATH" "$DEPLOY_CONFIG" "$OUT_DIR" --runs text
status=$?

echo "[$(date)] debug_quality python exited status=$status"
if [ -f "$OUT_DIR/quality_diagnostics.json" ]; then
  echo "[$(date)] diagnostics:"
  cat "$OUT_DIR/quality_diagnostics.json"
fi

if [ $status -ne 0 ]; then
  echo "[$(date)] Text-quality run FAILED (exit=$status)"
else
  echo "[$(date)] Text-quality run completed."
fi
} 2>&1 | tee "$RUN_LOG"
