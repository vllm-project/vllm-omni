#!/bin/bash
#PBS -N longcat_next_wired_e2e
#PBS -l select=1:ncpus=64:ngpus=5:mem=440gb
#PBS -l walltime=01:00:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_wired_e2e.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_wired_e2e.err

# Single-node, wired 3-stage LongCat-Next e2e test: thinker (TP=4 fp8, GPUs 0-3)
# + image decoder (GPU 4) + audio decoder (GPU 4), via the real orchestrated
# pipeline (longcat_next_5gpu_a40_image_audio.yaml, pipeline: longcat_next).
# Tests both audio and image modalities in sequence.

set -u

export CUDA_VISIBLE_DEVICES=0,1,2,3,4
export CUDA_HOME=/app/apps/cuda/12.8.1
export HF_HOME=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads
export UV_CACHE_DIR=/scratch/users/ntu/karthik0/.uv_cache
export NCCL_DEBUG=WARN
export VLLM_LOG_STATS_INTERVAL=10
export VLLM_USE_FLASHINFER_SAMPLER=0
export VLLM_LOGGING_LEVEL=INFO
export PYTHONFAULTHANDLER=1
export PYTHONUNBUFFERED=1
export TORCH_SHOW_CPP_STACKTRACES=1
export CUDA_LAUNCH_BLOCKING=1
export LONGCAT_AUDIO_DEBUG=1
export LONGCAT_MAX_GEN=300

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VENV="$OMNI_DIR/.venv"
MODEL_PATH=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads/hub/models--meituan-longcat--LongCat-Next/snapshots/0cf0631862402ff36366e513e4023d22e7e5c84c
DEPLOY_CONFIG="$OMNI_DIR/vllm_omni/deploy/longcat_next_5gpu_a40_image_audio.yaml"
RESULT_DIR="$OMNI_DIR/pbs/logs"
RUN_TS="$(date +%Y%m%d_%H%M%S)"
OUT_DIR="$RESULT_DIR/longcat_next_wired_e2e_${RUN_TS}"
RUN_LOG="${OUT_DIR}.log"
STATUS_FILE="$RESULT_DIR/.wired_e2e_status_$$"

mkdir -p "$RESULT_DIR" "$OUT_DIR"
source "$VENV/bin/activate"
cd "$OMNI_DIR"

{
echo "[$(date)] ===== LongCat-Next WIRED E2E test (all modalities) ====="
echo "[$(date)] job=${PBS_JOBID:-<none>} node=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
echo "[$(date)] out_dir=$OUT_DIR"
nvidia-smi -L
echo "[$(date)] --- code version ---"
git -C "$OMNI_DIR" rev-parse HEAD 2>/dev/null && git -C "$OMNI_DIR" status --short 2>/dev/null | head -30
echo "[$(date)] --- deploy config ---"
cat "$DEPLOY_CONFIG"

echo "[$(date)] Running wired 3-stage pipeline ..."
stdbuf -oL -eL python -X faulthandler pbs/scripts/longcat_next_wired_e2e.py \
  "$MODEL_PATH" "$DEPLOY_CONFIG" "$OUT_DIR"
status=$?

echo "[$(date)] wired-e2e python exited status=$status"
if [ -f "$OUT_DIR/result.json" ]; then
  echo "[$(date)] result: $(cat "$OUT_DIR/result.json")"
fi
if [ -f "$OUT_DIR/audio.wav" ]; then
  echo "[$(date)] audio.wav: $(wc -c < "$OUT_DIR/audio.wav") bytes"
fi
if [ -f "$OUT_DIR/image.png" ]; then
  echo "[$(date)] image.png: $(wc -c < "$OUT_DIR/image.png") bytes"
fi

if [ $status -ne 0 ]; then
  echo "[$(date)] Wired-e2e stage FAILED (exit=$status)"
else
  echo "[$(date)] Wired-e2e run completed."
fi
echo "$status" > "$STATUS_FILE"
} 2>&1 | tee "$RUN_LOG"

{
echo "[$(date)] ================ WIRED E2E SUMMARY ================"
echo "--- returned stage messages ---"
grep -a "\[wired\] outputs\[" "$RUN_LOG"
echo "--- audio result ---"
grep -a "\[wired-audio\]" "$RUN_LOG"
echo "--- image result ---"
grep -a "\[wired-image\]" "$RUN_LOG"
echo "--- overall ---"
grep -a "\[wired\] Overall" "$RUN_LOG"
echo "--- audio-gen debug lines (thinker side) ---"
echo "  advance : $(grep -ac 'longcat-audio.*advance step=' "$RUN_LOG" || true)"
echo "  mtp     : $(grep -ac 'longcat-audio.*mtp step='     "$RUN_LOG" || true)"
echo "  emit    : $(grep -ac 'make_omni_output emitting'    "$RUN_LOG" || true)"
echo "[$(date)] ======================================================"
} 2>&1 | tee -a "$RUN_LOG"

status="$(cat "$STATUS_FILE" 2>/dev/null || echo 1)"
rm -f "$STATUS_FILE"
exit "$status"
