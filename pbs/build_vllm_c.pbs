#!/bin/bash
#PBS -N build_vllm_c
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=02:00:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/build_vllm_c.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/build_vllm_c.err

# Builds vllm's compiled _C extension (csrc/, incl. the ngram_compute_n_gram_ids
# kernel LongCat-Next's preprocess() needs) from source. No GPU needed --
# nvcc cross-compiles. Runs on a dedicated CPU-only allocation, not the shared
# login node: the login-node build (MAX_JOBS=4) got a `cicc` process
# OOM-killed by the per-session memory cgroup (confirmed via dmesg:
# "Memory cgroup out of memory: Killed process ... (cicc)") at
# vllm-flash-attn/.../flash_fwd_hdim128_bf16_sm80.cu.o, the same class of
# large templated kernel file that forced MAX_JOBS down to 2 for the
# standalone flash-attn build earlier in this project. MAX_JOBS=2 here for
# the same reason, on a larger dedicated 64gb allocation for headroom.

set -u

export CC=/app/apps/gcc/12.3.0-nscc/bin/gcc
export CXX=/app/apps/gcc/12.3.0-nscc/bin/g++
# nvcc does not use CC/CXX to pick its host compiler -- CMake's CUDA language
# support reads CUDAHOSTCXX (or -ccbin) instead. Without this, nvcc silently
# fell back to the system default g++ 8.5.0 (first on PATH), which doesn't
# support the -std=c++20 flag CMake requests, causing cascading parse errors
# in torch's headeronly/ headers (bit_cast, numeric_limits, etc.) that look
# like unrelated compiler bugs but are really "C++20 silently downgraded".
export CUDAHOSTCXX=/app/apps/gcc/12.3.0-nscc/bin/g++
export CUDACXX=/app/apps/cuda/12.8.1/bin/nvcc
export PATH=/app/apps/gcc/12.3.0-nscc/bin:/app/apps/cuda/12.8.1/bin:$PATH
export CUDA_HOME=/app/apps/cuda/12.8.1
export TORCH_CUDA_ARCH_LIST="8.0"
export MAX_JOBS=2
export NVCC_THREADS=1
export UV_CACHE_DIR=/scratch/users/ntu/karthik0/.uv_cache

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VLLM_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm
VENV="$OMNI_DIR/.venv"

source "$VENV/bin/activate"
cd "$VLLM_DIR"

echo "[$(date)] node=$(hostname)"
echo "[$(date)] CC=$CC CXX=$CXX CUDAHOSTCXX=$CUDAHOSTCXX MAX_JOBS=$MAX_JOBS"
"$CXX" --version | head -1
nvcc --version | tail -3

echo "[$(date)] Building vllm._C (this can take a long time; MAX_JOBS=$MAX_JOBS)..."
uv pip install -e . --no-build-isolation --no-deps --verbose

echo "[$(date)] Build finished with exit code $?"

echo "[$(date)] Verifying vllm._C import and the ngram kernel..."
python -c "
import torch
import vllm._C
print('vllm._C imported OK')
print('has ngram_compute_n_gram_ids:', hasattr(torch.ops._C, 'ngram_compute_n_gram_ids'))
"

echo "[$(date)] Running longcat_next unit tests as a sanity check..."
cd "$OMNI_DIR"
python -m pytest tests/model_executor/stage_input_processors/test_longcat_next.py -q

echo "[$(date)] Done."
