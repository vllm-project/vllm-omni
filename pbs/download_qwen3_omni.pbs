#!/bin/bash
#PBS -N download_qwen3_omni
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=04:00:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/download_qwen3_omni.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/download_qwen3_omni.err

set -u

export HF_HOME=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads
export HF_XET_CACHE=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads/xet
export HF_HUB_ENABLE_HF_TRANSFER=0

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VENV=/scratch/users/ntu/karthik0/opensource_stff/vllm/.venv

RESULT_DIR="$OMNI_DIR/pbs/logs"
mkdir -p "$RESULT_DIR"

source "$VENV/bin/activate"

echo "[$(date)] === Qwen3-Omni-30B-A3B-Instruct download ==="
echo "[$(date)] job=${PBS_JOBID:-<none>} node=$(hostname)"
echo "[$(date)] HF_HOME=$HF_HOME"
echo "[$(date)] HF_XET_CACHE=$HF_XET_CACHE"
echo "[$(date)] hf-xet version: $(python -c 'import hf_xet; print(hf_xet.__version__)' 2>/dev/null || echo 'unknown')"
echo "[$(date)] huggingface_hub version: $(python -c 'import huggingface_hub; print(huggingface_hub.__version__)')"

echo "[$(date)] Starting download..."
hf download Qwen/Qwen3-Omni-30B-A3B-Instruct --quiet

EXIT_CODE=$?
if [ $EXIT_CODE -eq 0 ]; then
    echo "[$(date)] Download complete."
    echo "[$(date)] Model cached at: $HF_HOME/hub/models--Qwen--Qwen3-Omni-30B-A3B-Instruct"
    ls -la "$HF_HOME/hub/models--Qwen--Qwen3-Omni-30B-A3B-Instruct/snapshots/"/*/
else
    echo "[$(date)] Download failed with exit code $EXIT_CODE"
fi
echo "[$(date)] === Done ==="
