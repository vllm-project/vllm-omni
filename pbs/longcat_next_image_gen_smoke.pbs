#!/bin/bash
#PBS -N longcat_next_image_gen_smoke
#PBS -l select=1:ncpus=64:ngpus=4:mem=440gb
# 20min: first-ever GPU exercise of image GENERATION (visual_head sampling,
# _advance_visual_gen state machine, codes reaching multimodal_output).
# Same discipline as the very first audio-gen validation runs -- prove the
# mechanism on a small, bounded grid before ever touching the image decoder
# stage or a full-size image. Weight load alone measured ~10 min on this
# same fp8 config in every prior audio-gen run.
#PBS -l walltime=00:20:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_image_gen_smoke.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_image_gen_smoke.err

# Single-node, thinker-only image-gen smoke test (longcat_next_4gpu.yaml,
# the same fp8 TP=4 config every successful audio-gen run has used -- its
# memory profile is already proven on this hardware). No image decoder
# stage involved yet; this only checks whether talker_mtp's visual branch
# produces real codes that reach the client, same as the very first
# thinker-only audio-gen test before the decoder was ever touched.

set -u

export CUDA_VISIBLE_DEVICES=0,1,2,3
export CUDA_HOME=/app/apps/cuda/12.8.1
export HF_HOME=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads
export UV_CACHE_DIR=/scratch/users/ntu/karthik0/.uv_cache
export NCCL_DEBUG=WARN
export VLLM_LOG_STATS_INTERVAL=10
export VLLM_USE_FLASHINFER_SAMPLER=0
export VLLM_LOGGING_LEVEL=INFO
export PYTHONFAULTHANDLER=1
export PYTHONUNBUFFERED=1
export TORCH_SHOW_CPP_STACKTRACES=1
export CUDA_LAUNCH_BLOCKING=1
# Reused for image-gen too (modeling_longcat_next.py's visual branch logs
# under the same self._audio_debug flag, [longcat-image] prefix).
export LONGCAT_AUDIO_DEBUG=1

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VENV="$OMNI_DIR/.venv"
MODEL_PATH=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads/hub/models--meituan-longcat--LongCat-Next/snapshots/0cf0631862402ff36366e513e4023d22e7e5c84c
DEPLOY_CONFIG="$OMNI_DIR/vllm_omni/deploy/longcat_next_4gpu.yaml"
RESULT_DIR="$OMNI_DIR/pbs/logs"
RUN_TS="$(date +%Y%m%d_%H%M%S)"
RUN_LOG="$RESULT_DIR/longcat_next_image_gen_smoke_${RUN_TS}.log"
OUT_JSON="$RESULT_DIR/longcat_next_image_gen_smoke_${RUN_TS}.json"
STATUS_FILE="$RESULT_DIR/.image_gen_smoke_status_$$"

mkdir -p "$RESULT_DIR"
source "$VENV/bin/activate"
cd "$OMNI_DIR"

{
echo "[$(date)] ===== LongCat-Next IMAGE-GEN smoke test (thinker only) ====="
echo "[$(date)] job=${PBS_JOBID:-<none>} node=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
echo "[$(date)] run_log=$RUN_LOG out_json=$OUT_JSON"
nvidia-smi -L
echo "[$(date)] --- code version ---"
git -C "$OMNI_DIR" rev-parse HEAD 2>/dev/null
git -C "$OMNI_DIR" status --short 2>/dev/null | head -30

echo "[$(date)] Running image-gen thinker-only smoke ..."
stdbuf -oL -eL python -X faulthandler pbs/scripts/longcat_next_image_gen_thinker.py \
  "$MODEL_PATH" "$DEPLOY_CONFIG" "$OUT_JSON"
status=$?

echo "[$(date)] image-gen python exited status=$status"
if [ -f "$OUT_JSON" ]; then
  echo "[$(date)] result json head: $(head -c 400 "$OUT_JSON")"
fi

if [ $status -ne 0 ]; then
  echo "[$(date)] Image-gen smoke test FAILED (exit=$status)"
else
  echo "[$(date)] Image-gen smoke test completed."
fi
echo "$status" > "$STATUS_FILE"
} 2>&1 | tee "$RUN_LOG"

{
echo "[$(date)] ================ IMAGE-GEN SMOKE SUMMARY ================"
echo "--- prompt / entry conditions (did image-gen engage at all?) ---"
grep -a -E "\[image-gen\] prompt tokens=|ends with img_start" "$RUN_LOG"
echo "--- state machine (thinker side) ---"
grep -a -E "longcat-image.*visual_gen created|longcat-image.*TERMINAL" "$RUN_LOG" | head -10
echo "--- first advance/mtp steps ---"
grep -a "longcat-image.*advance step=" "$RUN_LOG" | head -12
grep -a "longcat-image.*mtp step=" "$RUN_LOG" | head -12
echo "--- make_omni_output emissions ---"
grep -a "make_omni_output emitting" "$RUN_LOG" | head -10
echo "--- line counts ---"
echo "  advance : $(grep -ac 'longcat-image.*advance step=' "$RUN_LOG" || true)"
echo "  mtp     : $(grep -ac 'longcat-image.*mtp step='     "$RUN_LOG" || true)"
echo "  emit    : $(grep -ac 'make_omni_output emitting'     "$RUN_LOG" || true)"
echo "--- generated text / verdict ---"
grep -a -E "\[image-gen\] (VERDICT|talker_mtp produced|multimodal_output type|frame widths|frames containing|generated |decoded visible|markers in)" "$RUN_LOG"
echo "[$(date)] =========================================================="
} 2>&1 | tee -a "$RUN_LOG"

status="$(cat "$STATUS_FILE" 2>/dev/null || echo 1)"
rm -f "$STATUS_FILE"
exit "$status"
