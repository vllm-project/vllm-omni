#!/bin/bash
#PBS -N longcat_audio_decoder_standalone
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=00:15:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_audio_decoder_standalone.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_audio_decoder_standalone.err

# Standalone LongcatNextAudioDecoder smoke test: no vLLM engine, no
# orchestrator, no thinker. Just constructs the module, loads its weights,
# and decodes both the real known-good codes (job 15025030) and a longer
# synthetic sequence on a single GPU. Purpose: verify the decoder's own
# correctness and measure its real VRAM footprint (no MoE weights -- just
# VQ bridger + flow matching + Cosy24k vocoder) in isolation, decoupled
# from the "does it fit alongside the 74B thinker on a 40GB card" question
# (it doesn't, on paper -- see longcat_next_4gpu_audio.yaml's 80GB-tuned
# assumptions vs this cluster's actual A100-40GB hardware).

set -u
export CUDA_VISIBLE_DEVICES=0
export CUDA_HOME=/app/apps/cuda/12.8.1
export HF_HOME=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads
export UV_CACHE_DIR=/scratch/users/ntu/karthik0/.uv_cache
export PYTHONFAULTHANDLER=1
export PYTHONUNBUFFERED=1
export TORCH_SHOW_CPP_STACKTRACES=1
export CUDA_LAUNCH_BLOCKING=1

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VENV="$OMNI_DIR/.venv"
MODEL_PATH=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads/hub/models--meituan-longcat--LongCat-Next/snapshots/0cf0631862402ff36366e513e4023d22e7e5c84c
RESULT_DIR="$OMNI_DIR/pbs/logs"
RUN_TS="$(date +%Y%m%d_%H%M%S)"
RUN_LOG="$RESULT_DIR/longcat_next_audio_decoder_standalone_${RUN_TS}.log"
OUT_PREFIX="$RESULT_DIR/longcat_next_audio_decoder_standalone_${RUN_TS}"
STATUS_FILE="$RESULT_DIR/.decoder_standalone_status_$$"

mkdir -p "$RESULT_DIR"
source "$VENV/bin/activate"
cd "$OMNI_DIR"

{
echo "[$(date)] ===== LongCat-Next audio DECODER standalone smoke test ====="
echo "[$(date)] job=${PBS_JOBID:-<none>} node=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
nvidia-smi -L
echo "[$(date)] run_log=$RUN_LOG"
echo "[$(date)] --- code version ---"
git -C "$OMNI_DIR" rev-parse HEAD 2>/dev/null && git -C "$OMNI_DIR" status --short 2>/dev/null | head -30

stdbuf -oL -eL python -X faulthandler pbs/scripts/longcat_next_audio_decoder_standalone.py \
  "$MODEL_PATH" "$OUT_PREFIX"
status=$?

echo "[$(date)] decoder-standalone python exited status=$status"
if [ -f "${OUT_PREFIX}.json" ]; then
  echo "[$(date)] result json: $(cat "${OUT_PREFIX}.json")"
fi
for wav in "${OUT_PREFIX}_real.wav" "${OUT_PREFIX}_synthetic.wav"; do
  if [ -f "$wav" ]; then
    echo "[$(date)] $(basename "$wav") size: $(wc -c < "$wav") bytes"
  fi
done

if [ $status -ne 0 ]; then
  echo "[$(date)] Decoder standalone test FAILED (exit=$status)"
else
  echo "[$(date)] Decoder standalone test completed."
fi
echo "$status" > "$STATUS_FILE"
} 2>&1 | tee "$RUN_LOG"

{
echo "[$(date)] ================ DECODER STANDALONE SUMMARY ================"
echo "--- memory footprint ---"
grep -a -E "Before load|After weight load|Peak allocated|After decode" "$RUN_LOG"
echo "--- decode results ---"
grep -a -E "\[real_codes\]|\[synthetic_codes\]" "$RUN_LOG"
echo "--- verdict ---"
grep -a "VERDICT" "$RUN_LOG"
echo "[$(date)] =============================================================="
} 2>&1 | tee -a "$RUN_LOG"

status="$(cat "$STATUS_FILE" 2>/dev/null || echo 1)"
rm -f "$STATUS_FILE"
exit "$status"
