#!/bin/bash
#PBS -N longcat_next_e2e_audio
#PBS -l select=1:ncpus=64:ngpus=4:mem=440gb
#PBS -l walltime=00:30:00
#PBS -o /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_e2e_audio.out
#PBS -e /scratch/users/ntu/karthik0/opensource_stff/vllm-omni/pbs/logs/longcat_next_e2e_audio.err

# Single-node end-to-end LongCat-Next audio generation test.
#
# Runs the official vllm-omni multi-stage pipeline: thinker (TP=4 fp8 on
# devices 0,1,2,3) + audio decoder (colocated on GPU 3 alongside TP rank 3)
# under a single in-process orchestrator.  No file handoff, no Ray, no
# Mooncake -- this is the standard vllm-omni pipeline path.
#
# Hardware: 1 node x 4 A100-40GB.  Uses longcat_next_4gpu_audio_fp8.yaml
# (pipeline: longcat_next_thinker_audio).
#
# Memory budget (from standalone measurements):
#   fp8 thinker:   33.79 GiB weights+non-torch + 1.28 GiB peak activation
#                   + 0.98 GiB KV cache = ~36.05 GiB per GPU
#   audio decoder: ~3.33 GiB (colocated on GPU 3 with TP rank 3)
#   Total GPU 3:   36.05 + 3.33 = 39.38 GiB out of 39.49 GiB total
#   Margin:        ~0.11 GiB (razor thin -- may OOM)
#
# If this OOMs, switch to the 2-node file-handoff path instead
# (longcat_next_multinode_thinker + longcat_next_multinode_audio_decoder).

set -u

export CUDA_VISIBLE_DEVICES=0,1,2,3
export CUDA_HOME=/app/apps/cuda/12.8.1
export HF_HOME=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads
export UV_CACHE_DIR=/scratch/users/ntu/karthik0/.uv_cache
export NCCL_DEBUG=WARN
export VLLM_USE_FLASHINFER_SAMPLER=0
export VLLM_LOGGING_LEVEL=INFO
export PYTHONFAULTHANDLER=1
export PYTHONUNBUFFERED=1
export TORCH_SHOW_CPP_STACKTRACES=1
export CUDA_LAUNCH_BLOCKING=1
export LONGCAT_AUDIO_DEBUG=1
export LONGCAT_MAX_GEN=300

OMNI_DIR=/scratch/users/ntu/karthik0/opensource_stff/vllm-omni
VENV=/scratch/users/ntu/karthik0/opensource_stff/vllm/.venv
MODEL_PATH=/scratch/users/ntu/karthik0/opensource_stff/hf_downloads/hub/models--meituan-longcat--LongCat-Next/snapshots/0cf0631862402ff36366e513e4023d22e7e5c84c
DEPLOY_CONFIG="$OMNI_DIR/vllm_omni/deploy/longcat_next_4gpu_audio_fp8.yaml"
RESULT_DIR="$OMNI_DIR/pbs/logs"
OUT_WAV="$RESULT_DIR/longcat_next_e2e_audio.wav"
OUT_JSON="$RESULT_DIR/longcat_next_e2e_audio.json"
RUN_TS="$(date +%Y%m%d_%H%M%S)"
RUN_LOG="$RESULT_DIR/longcat_next_e2e_audio_${RUN_TS}.log"

mkdir -p "$RESULT_DIR"
source "$VENV/bin/activate"
cd "$OMNI_DIR"

{
echo "[$(date)] ===== LongCat-Next e2e AUDIO (wired pipeline) ====="
echo "[$(date)] job=${PBS_JOBID:-<none>} node=$(hostname) gpus=$(nvidia-smi -L | wc -l)"
echo "[$(date)] run_log=$RUN_LOG"
nvidia-smi -L
echo "[$(date)] --- code version ---"
git -C "$OMNI_DIR" rev-parse HEAD 2>/dev/null && git -C "$OMNI_DIR" status --short 2>/dev/null | head -30
echo "[$(date)] --- env ---"
echo "deploy_config=$DEPLOY_CONFIG"
echo "out_wav=$OUT_WAV out_json=$OUT_JSON"
echo "[$(date)] --- starting generate ---"

python -X faulthandler pbs/scripts/longcat_next_wired_audio.py \
  "$MODEL_PATH" "$DEPLOY_CONFIG" "$OUT_WAV" "$OUT_JSON"

status=$?
echo "[$(date)] wired_audio.py exited status=$status"
if [ -f "$OUT_WAV" ]; then
  echo "[$(date)] output wav size: $(wc -c < "$OUT_WAV") bytes"
fi
if [ -f "$OUT_JSON" ]; then
  echo "[$(date)] result json: $(cat "$OUT_JSON")"
fi

if [ $status -ne 0 ]; then
  echo "[$(date)] e2e test FAILED (exit=$status)"
  exit 1
fi

echo "[$(date)] Done. Output: $OUT_WAV"
} 2>&1 | tee "$RUN_LOG"
exit "${PIPESTATUS[0]}"
