  {
    "test_name": "test_minicpmo_4_5_async_prefix_daily_omni",
    "description": "CUDA nightly async_chunk + Thinker prefix cache, turn serving. One C8 pass of all 1197 Daily-Omni items records ttft/tpot/e2e and gates overall accuracy at 0.77. MiniCPM interleaved recipe: temperature 0, output-len 512, minicpm-interleave, text modalities. Prefix-on baselines start empty until a measured H100/B200 window is collected. Stage-0 ngram is removed because omni prefix cache refuses speculative decoding. Shares the async-prefix CUDA nightly job with Seed-TTS, so this entry is cards_2.",
    "mark": [
      {
        "hardware_marks": {
          "res": {
            "cuda": ["H100", "B200"]
          },
          "num_cards": 2
        }
      },
      "full_model",
      "omni"
    ],
    "server_params": {
      "model": "openbmb/MiniCPM-o-4_5",
      "extra_cli_args": [
        "--deploy-config",
        "vllm_omni/deploy/minicpmo_4_5_turn.yaml",
        "--trust-remote-code"
      ],
      "update": {
        "async_chunk": true,
        "session_mode": "turn",
        "stages": {
          "0": {
            "enable_prefix_caching": true
          }
        },
        "platforms.cuda.stages.0.enable_prefix_caching": true
      },
      "delete": {
        "stages": {
          "0": ["speculative_config"]
        },
        "platforms.cuda.stages.0.speculative_config": null
      }
    },
    "benchmark_params": [
      {
        "dataset_name": "daily-omni",
        "dataset_path": "liarliar/Daily-Omni",
        "backend": "openai-chat-omni",
        "endpoint": "/v1/chat/completions",
        "num_prompts": [1197],
        "max_concurrency": [8],
        "num_warmups": 0,
        "no_oversample": true,
        "disable_shuffle": true,
        "trust_remote_code": true,
        "temperature": 0,
        "output_len": 512,
        "daily_omni_input_mode": "all",
        "daily_omni_pack_mode": "minicpm-interleave",
        "daily_omni_inline_local_video": true,
        "min_daily_omni_accuracy": 0.77,
        "extra_body": {
          "modalities": ["text"],
          "chat_template_kwargs": {
            "enable_thinking": false
          }
        },
        "percentile-metrics": "ttft,tpot,e2el",
        "baseline": {}
      }
