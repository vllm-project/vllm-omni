[
  {
    "test_name": "test_minicpmo_4_5_default",
    "description": "CUDA nightly default serving: --no-async-chunk and prefix cache off on the duplex deploy. One C64 English Seed-TTS pass of all 1088 utterances records ttft/tpot/rtf/ttfp/throughput/e2e and gates WER 0.05 / SIM 0.80. max_num_seqs is 64; drop stages and duplex_session.max_sessions to 32 if this OOMs. Whisper/SIM scoring uses the second GPU. Performance baselines start empty until a measured H100/B200 window is collected.",
    "mark": [
      {
        "hardware_marks": {
          "res": {
            "cuda": ["H100", "B200"]
          },
          "num_cards": 2
        }
      },
      "full_model",
      "omni"
    ],
    "server_params": {
      "model": "openbmb/MiniCPM-o-4_5",
      "extra_cli_args": [
        "--deploy-config",
        "vllm_omni/deploy/minicpmo_4_5.yaml",
        "--trust-remote-code",
        "--no-async-chunk"
      ],
      "update": {
        "async_chunk": false,
        "duplex_session.max_sessions": 64,
        "stages": {
          "0": {
            "max_num_seqs": 64
          },
          "1": {
            "max_num_seqs": 64
          },
          "2": {
            "max_num_seqs": 64
          }
        },
        "platforms.cuda.stages.2.max_num_seqs": 64
      }
    },
    "benchmark_params": [
      {
        "dataset_name": "seed-tts",
        "dataset_path": "zhaochenyang20/seed-tts-eval",
        "backend": "openai-chat-omni",
        "endpoint": "/v1/chat/completions",
        "num_prompts": [1088],
        "max_concurrency": [64],
        "num_warmups": 0,
        "no_oversample": true,
        "disable_shuffle": true,
        "trust_remote_code": true,
        "seed_tts_locale": "en",
        "seed_tts_wer_eval": true,
        "omni_fail_fast_on_timeout": true,
        "max_seed_tts_mean_wer": 0.05,
        "min_seed_tts_mean_sim": 0.8,
        "extra_body": {
          "modalities": ["text", "audio"],
          "chat_template_kwargs": {
            "enable_thinking": false,
            "use_tts_template": true
          }
        },
        "percentile-metrics": "ttft,tpot,e2el,audio_ttfp,audio_rtf,audio_duration",
        "baseline": {}
      }
    ]
  },
