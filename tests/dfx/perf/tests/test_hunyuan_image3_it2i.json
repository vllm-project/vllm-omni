[
  {
    "test_name": "test_hunyuan_image3_distil_fp8_ar_tp2_dit_sp2",
    "mark": [
      {
        "hardware_marks": {
          "res": {
            "cuda": [
              "H100",
              "B200"
            ],
            "npu": "A3"
          },
          "num_cards": 4
        }
      },
      "diffusion",
      "full_model"
    ],
    "description": "FP8 distilled weights; non-duplex AR TP=2 on GPUs 0,1 + DiT TP=1 SP=2 on GPUs 2,3; custom dataset; concurrency 1,16",
    "server_params": {
      "model": "tencent/HunyuanImage-3.0-Instruct-Distil",
      "serve_args": {
        "trust-remote-code": true,
        "enable-diffusion-pipeline-profiler": true,
        "stage-init-timeout": 900,
        "init-timeout": 1800,
        "quantization": "fp8",
        "deploy-config": "vllm_omni/deploy/hunyuan_image_3_moe.yaml"
      },
      "stage_overrides": {
        "0": {
          "devices": "0,1",
          "tensor_parallel_size": 2,
          "max_num_seqs": 16,
          "gpu_memory_utilization": 0.85,
          "enforce_eager": false,
          "enable_prefix_caching": false,
          "max_num_batched_tokens": 32768
        },
        "1": {
          "devices": "2,3",
          "max_num_batched_tokens": 32768,
          "parallel_config": {
            "tensor_parallel_size": 1,
            "sequence_parallel_size": 2,
            "ulysses_degree": 2,
            "ring_degree": 1,
            "allgather_degree": 1,
            "enable_expert_parallel": true,
            "vae_patch_parallel_size": 2
          },
          "vae_use_tiling": true
        }
      },
      "update": {
        "stages": {
          "0": {
            "output_connectors": {
              "to_stage_1": "shared_memory_connector"
            }
          },
          "1": {
            "input_connectors": {
              "from_stage_0": "shared_memory_connector"
            },
            "omni_kv_config.enable_kv_async_prefetch": false
          }
        }
      }
    },
    "benchmark_params": [
      {
        "name": "custom_it2i_steps8",
        "endpoint": "/v1/images/edits",
        "num_prompts": [
          16,
          96
        ],
        "max_concurrency": [
          1,
          16
        ],
        "percentile_metrics": "e2el",
        "baseline": {},
        "dataset_name": "custom_image",
        "dataset_path": "tests/assets/hunyuan_image3/perf_it2i.jsonl",
        "skip_tokenizer_init": true,
        "disable_shuffle": true,
        "extra_body": {
          "guidance_scale": 2.5,
          "sys_type": "en_unified",
          "bot_task": "think_recaption",
          "num_inference_steps": 8,
          "seed": 42
        }
      }
    ]
  }
]
