    "test_name": "test_hunyuan_image3_prefix_dense",
    "mark": [{"hardware_marks": {"res": {"cuda": "H100"}, "num_cards": 4}}, "diffusion", "local_model"],
    "description": "Same-reference, fixed-seed, distinct-edit workload: dense baseline (TP4, CFGP1)",
