        "random_output_len": 1,
        "percentile_metrics": "e2el",
        "extra_body": {
          "width": 1024,
          "height": 1024,
          "num_inference_steps": 4,
          "seed": 42,
          "guidance_scale": 7.0,
          "flow_shift": 3.0,
          "guardrails": false,
          "return_stage_metrics": true
