        "backend": "sglang",
        "num-gpus": 2,
        "tp-size": 2,
        "sp-degree": 1,
        "cfg-parallel-size": 1,
        "use-fsdp-inference": false,
        "warmup-mode": "off"
      },
      "env": {
        "SGLANG_DISABLE_COSMOS3_GUARDRAILS": "1"
