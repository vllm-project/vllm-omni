          },
          "accuracy_baseline": {
            "max_seed_tts_mean_wer": 0.05,
            "min_seed_tts_mean_sim": 0.75
          }
        },
        "result_metadata": {
          "benchmark_suite": "qwen3-omni-datasets",
          "configuration": "default",
          "async_chunk": false,
          "thinker_prefix_caching": false,
