          }
        }
      }
    },
    "benchmark_params": [
      {
        "name": "default-seed-tts-c64",
        "dataset_name": "seed-tts",
        "num_prompts": [
          1088
        ],
        "max_concurrency": [
          64
        ],
        "num_warmups": 64,
        "backend": "openai-chat-omni",
        "endpoint": "/v1/chat/completions",
        "temperature": 0,
        "no_oversample": true,
        "disable_shuffle": true,
