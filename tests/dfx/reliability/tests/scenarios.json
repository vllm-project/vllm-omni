[
  {
    "test_name": "qwen3_omni_abnormal_then_ok",
    "server_params": {
      "model": "Qwen/Qwen3-Omni-30B-A3B-Instruct",
      "stage_config_name": "qwen3_omni_ci.yaml",
      "update": {
        "async_chunk": true,
        "stage_args": {
          "0": {
            "engine_args.custom_process_next_stage_input_func": "vllm_omni.model_executor.stage_input_processors.qwen3_omni.thinker2talker_async_chunk"
          },
          "1": {
            "engine_args.custom_process_next_stage_input_func": "vllm_omni.model_executor.stage_input_processors.qwen3_omni.talker2code2wav_async_chunk"
          }
        }
      },
      "delete": {
        "stage_args": {
          "2": ["custom_process_input_func"]
        }
      }
    },
    "scenario": {
      "type": "abnormal_input",
      "fault_params": {
        "variants": ["malformed_json", "invalid_messages_type"]
      },
      "expect": {
        "fault_http_status_class": "4xx",
        "process_alive": true,
        "min_post_success": 1
      },
      "recovery_request": {
        "content_text": "What is the capital of China? Reply with one word.",
        "key_words": { "text": ["beijing"] },
        "modalities": ["text"],
        "stream": false
      }
    }
  },
  {
    "test_name": "qwen3_omni_abnormal_then_ok_no_async_chunk",
    "server_params": {
      "model": "Qwen/Qwen3-Omni-30B-A3B-Instruct",
      "stage_config_name": "qwen3_omni_ci.yaml",
      "delete": {
        "stage_args": {
          "2": ["custom_process_input_func"]
        }
      }
    },
    "scenario": {
      "type": "abnormal_input",
      "fault_params": {
        "variants": ["malformed_json", "invalid_messages_type"]
      },
      "expect": {
        "fault_http_status_class": "4xx",
        "process_alive": true,
        "min_post_success": 1
      },
      "recovery_request": {
        "content_text": "What is the capital of China? Reply with one word.",
        "key_words": { "text": ["beijing"] },
        "modalities": ["text"],
        "stream": false
      }
    }
  }
]
