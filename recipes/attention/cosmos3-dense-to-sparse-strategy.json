{
  "presets": {
    "fa3_dense": {"backend": "FLASH_ATTN"},
    "fa4_subblock": {
      "name": "block_sparse",
      "config": {
        "block_size": [64, 64],
        "selection": {"name": "block_topk", "config": {"target_sparsity": 0.75}},
        "backend": {"require": "FLASH_ATTN", "implementation": "auto"}
      }
    }
  },
  "layouts": {
    "dense": {"default": "fa3_dense"},
    "sparse": {
      "default": "fa3_dense",
      "overrides": [{"attention_role": "cosmos3.gen", "use": "fa4_subblock"}]
    }
  },
  "schedule": {
    "coordinate": "step_index",
    "phases": [
      {"until": 10, "layout": "dense"},
      {"until": null, "layout": "sparse"}
    ]
  }
}
